// Store last map settings for rebuild
var lastMapSettings: MapSettings? = null

fun generateMap(settings: MapSettings) {
    // Keep a copy so rebuild doesn't mutate the original settings
    lastMapSettings = settings.copy()

    // Your normal map generation logic
    MapGenerator.generate(settings)  // Replace with actual map generation call
}

Create “Rebuild Map” button 
val rebuildButton = UIButton("Rebuild Map").apply {
    isEnabled = lastMapSettings != null  // Disable if no map yet
    onClick = {
        lastMapSettings?.let { settings ->
            generateMap(settings)
        } ?: run {
            println("No previous map to rebuild.")
        }
    }
}

